<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- AdMob app «سهرة وتسالي» (Android). The web app asks for ads through the AdMob plugin only inside this app. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-2789932744268807~6444336375"/>
        <!-- 1.7: Google's documented switches that move the Ads SDK's start-up and ad-loading work off the main thread (fewer
             ANRs). Harmless where the SDK version already does this by default. -->
        <meta-data android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION" android:value="true"/>
        <meta-data android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING" android:value="true"/>

        <!-- 1.6 Facebook SDK (core): app id + client token from build.gradle resValue; it logs the install and app opens by itself, so
             the Meta App Promotion campaign can optimise for installs. No JavaScript touches it. -->
        <meta-data android:name="com.facebook.sdk.ApplicationId" android:value="@string/facebook_app_id" />
        <meta-data android:name="com.facebook.sdk.ClientToken" android:value="@string/facebook_client_token" />
        <meta-data android:name="com.facebook.sdk.AutoInitEnabled" android:value="true" />
        <meta-data android:name="com.facebook.sdk.AutoLogAppEventsEnabled" android:value="true" />
        <meta-data android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled" android:value="true" />

        <!-- phone notifications (1.2, Firebase): our white «?» bubble in the status bar, gold accent, channel «default»
             (the web page creates it with a name on the first «فعّل»; the server sends android.notification.channel_id = default) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_sahrah" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="default" />
        <!-- 1.7: no FCM token work at every app start. Firebase now waits until the web page asks for notifications
             (PushNotifications.register(), only after the player's «فعّل» tap), which turns auto-init on for that phone
             (Firebase saves that, so phones that already allowed notifications in 1.2-1.6 keep getting them). -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- sign-in comes back from the Custom Tab as online.geddo.sahrah://auth?t=<one-time token>&next=<path> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="online.geddo.sahrah" android:host="auth" />
            </intent-filter>
            <!-- App Links (1.3): shared sahrah.geddo.online links open in the app (only game pages: never /api, /admin or the sign-in callbacks) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="sahrah.geddo.online" android:path="/" />
                <data android:scheme="https" android:host="sahrah.geddo.online" android:pathPrefix="/live9" />
                <data android:scheme="https" android:host="sahrah.geddo.online" android:pathPrefix="/duel" />
                <data android:scheme="https" android:host="sahrah.geddo.online" android:pathPrefix="/vs" />
                <data android:scheme="https" android:host="sahrah.geddo.online" android:pathPrefix="/know" />
                <data android:scheme="https" android:host="sahrah.geddo.online" android:pathPrefix="/r/" />
                <data android:scheme="https" android:host="sahrah.geddo.online" android:pathPrefix="/f/" />
                <data android:scheme="https" android:host="sahrah.geddo.online" android:pathPrefix="/v/" />
                <data android:scheme="https" android:host="sahrah.geddo.online" android:pathPrefix="/c/" />
                <data android:scheme="https" android:host="sahrah.geddo.online" android:pathPrefix="/q/" />
                <data android:scheme="https" android:host="sahrah.geddo.online" android:pathPrefix="/p/" />
                <data android:scheme="https" android:host="sahrah.geddo.online" android:pathPrefix="/room" />
                <data android:scheme="https" android:host="sahrah.geddo.online" android:pathPrefix="/try" />
                <data android:scheme="https" android:host="sahrah.geddo.online" android:pathPrefix="/daily" />
                <data android:scheme="https" android:host="sahrah.geddo.online" android:pathPrefix="/weekly" />
                <data android:scheme="https" android:host="sahrah.geddo.online" android:pathPrefix="/league" />
                <data android:scheme="https" android:host="sahrah.geddo.online" android:pathPrefix="/games" />
                <data android:scheme="https" android:host="sahrah.geddo.online" android:pathPrefix="/categories" />
                <data android:scheme="https" android:host="sahrah.geddo.online" android:pathPrefix="/play" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- voice chat in rooms / 1v1 (LiveKit through the web view's getUserMedia; Capacitor's BridgeWebChromeClient asks at run time) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- navigator.vibrate in the games -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 13+: the «Allow notifications» popup (asked only when the player taps «فعّل» for notifications) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 1.7: the app never uses the camera (voice only). Make sure no library ever adds the permission. -->
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />
    <!-- a phone without a mic can still install the app (voice is optional) -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
